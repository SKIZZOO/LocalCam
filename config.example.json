{
  "app_name": "LocalCam",
  "version": "0.5.0",
  "ffmpeg_path": "ffmpeg",
  "record_root": "G:/LocalCam/recordings",
  "snapshot_root": "G:/LocalCam/snapshots",
  "record_mode": "continuous",
  "segment_minutes": 10,
  "min_free_gb": 20,
  "max_retention_days": 30,
  "web_enabled": true,
  "web_bind": "0.0.0.0",
  "web_port": 8765,
  "web_live_fps": 6,
  "web_live_width": 960,
  "web_auto_open": true,
  "web_auth_enabled": true,
  "notifications_enabled": true,
  "web_password_hash": "",
  "web_secret": "",
  "motion": {
    "enabled": true,
    "interval_seconds": 0.75,
    "threshold": 8.0,
    "min_changed_fraction": 0.012,
    "cooldown_seconds": 15,
    "save_event_snapshots": true
  },
  "cameras": [
    {
      "id": "front-wide",
      "name": "Front - Wide",
      "url": "rtsp://CAMERA_IP:554/live/ch00_0",
      "username": "admin",
      "password": ""
    },
    {
      "id": "front-detail",
      "name": "Front - Detail",
      "url": "rtsp://CAMERA_IP:554/live/ch01_0",
      "username": "admin",
      "password": ""
    },
    {
      "id": "camera-2-main",
      "name": "Camera 2 - Main",
      "url": "rtsp://CAMERA_IP:554/live/ch00_0",
      "username": "admin",
      "password": ""
    },
    {
      "id": "camera-2-detail",
      "name": "Camera 2 - Detail",
      "url": "rtsp://CAMERA_IP:554/live/ch01_0",
      "username": "admin",
      "password": ""
    }
  ]
}
